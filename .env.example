# Ambiente local educacional — FIAP 5NETT, Fase 3.
# O comando no README cria o .env com os dois valores preenchidos.
# Se copiar este modelo, gere cada valor separadamente: openssl rand -hex 32

# Chave usada pela API para assinar os tokens JWT.
ESCOLA_JWT_CHAVE=

# Código para obter o token. Copie o valor para codigoAcesso no Postman.
ESCOLA_JWT_CODIGO=

# Porta local da API. Se alterar, ajuste baseUrl no Postman.
ESCOLA_PORTA_LOCAL=5080
